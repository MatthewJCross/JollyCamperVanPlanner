<Window x:Class="JollyCamperVanPlanner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Jolly Camper Planner" Width="1350" Height="1100" MinWidth="850" MinHeight="600" Background="#303640" WindowStyle="None" AllowsTransparency="True" WindowStartupLocation="CenterScreen">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="34" />
    </WindowChrome.WindowChrome>

    <Window.CommandBindings>
        <CommandBinding Command="{x:Static SystemCommands.CloseWindowCommand}" CanExecute="CommandBinding_CanExecute" Executed="CommandBinding_Executed_Close" />
        <CommandBinding Command="{x:Static SystemCommands.MaximizeWindowCommand}" CanExecute="CommandBinding_CanExecute" Executed="CommandBinding_Executed_Maximize" />
        <CommandBinding Command="{x:Static SystemCommands.MinimizeWindowCommand}" CanExecute="CommandBinding_CanExecute" Executed="CommandBinding_Executed_Minimize" />
        <CommandBinding Command="{x:Static SystemCommands.RestoreWindowCommand}" CanExecute="CommandBinding_CanExecute" Executed="CommandBinding_Executed_Restore" />
    </Window.CommandBindings>

    <DockPanel>
        
        <!-- Title Bar -->
        <Border DockPanel.Dock="Top" Height="52" Background="#20252D" BorderBrush="#343A42" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,0,2">
                    <Image Source="/Resources/CamperVan.ico"/>
                    <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="22" FontWeight="SemiBold" Foreground="White"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource MinimizeButtonStyle}" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Minimize" Command="{x:Static SystemCommands.MinimizeWindowCommand}"/>
                    <Button x:Name="RestoreButton" Visibility="Collapsed" Style="{StaticResource RestoreButtonStyle}" Command="{x:Static SystemCommands.RestoreWindowCommand}" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Restore"/>
                    <Button x:Name="MaximizeButton" Visibility="Visible" Style="{StaticResource MaximizeButtonStyle}" Command="{x:Static SystemCommands.MaximizeWindowCommand}" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Maximize" />
                    <Button Style="{StaticResource CloseButtonStyle}" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Close" Command="{x:Static SystemCommands.CloseWindowCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Top" Background="#303640" Padding="12" BorderBrush="Black" BorderThickness="1">
            <StackPanel>
                <WrapPanel VerticalAlignment="Center">
                    <TextBlock Text="Interior length (mm)" Foreground="White" VerticalAlignment="Center" Margin="4"/>
                    <TextBox x:Name="VanLengthBox" Text="6000" Width="75" Padding="5" Margin="4"/>
                    <TextBlock Text="Interior width (mm)" Foreground="White" VerticalAlignment="Center" Margin="4"/>
                    <TextBox x:Name="VanWidthBox" Text="1850" Width="75" Padding="5" Margin="4"/>
                    <Button Content="Apply Van Size" Click="ApplyVanSize_Click" Padding="12,6" Margin="4"/>
                    <Button Content="Save" Click="Save_Click" Padding="12,6" Margin="4"/>
                    <Button Content="Load" Click="Load_Click" Padding="12,6" Margin="4"/>
                    <Button Content="Print Floor Plan" Command="{Binding PrintFloorPlanCommand}" Padding="12,6" Margin="4"/>
                </WrapPanel>

                <Separator/>

                <WrapPanel>
                    <Button Content="Bed" Tag="Bed"  Command="{Binding AddFurnitureCommand}"  CommandParameter="{Binding Tag, RelativeSource={RelativeSource Self}}" Margin="3" Padding="14,7"/>
                    <Button Content="Kitchen" Tag="Kitchen" Command="{Binding AddFurnitureCommand}" CommandParameter="{Binding Tag, RelativeSource={RelativeSource Self}}" Margin="3" Padding="14,7"/>
                    <Button Content="Fridge" Tag="Fridge" Command="{Binding AddFurnitureCommand}" CommandParameter="{Binding Tag, RelativeSource={RelativeSource Self}}" Margin="3" Padding="14,7"/>
                    <Button Content="Sink" Tag="Sink" Command="{Binding AddFurnitureCommand}" CommandParameter="{Binding Tag, RelativeSource={RelativeSource Self}}" Margin="3" Padding="14,7"/>
                    <Button Content="Cupboard" Tag="Cupboard" Command="{Binding AddFurnitureCommand}" CommandParameter="{Binding Tag, RelativeSource={RelativeSource Self}}" Margin="3" Padding="14,7"/>
                    <Button Content="Table" Tag="Table" Command="{Binding AddFurnitureCommand}" CommandParameter="{Binding Tag, RelativeSource={RelativeSource Self}}" Margin="3" Padding="14,7"/>
                    <Button Content="Seat" Tag="Seat" Command="{Binding AddFurnitureCommand}" CommandParameter="{Binding Tag, RelativeSource={RelativeSource Self}}" Margin="3" Padding="14,7"/>
                   
                    <Separator Width="12" Opacity="0"/>

                    <Button Content="Rotate 90°" Command="{Binding RotateFurnitureCommand}" Margin="3" Padding="14,7"/>
                    <Button Content="Delete" Command="{Binding DeleteFurnitureCommand}" Margin="3" Padding="14,7"/>
                </WrapPanel>
        
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="#303640" Padding="10">
            <TextBlock x:Name="StatusText" Foreground="White" Text="Ready." FontSize="13"/>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="260"/>
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#303640" Margin="10">
                <Canvas x:Name="PlannerCanvas" Width="1000" Height="450" Background="#E4E1D8"  />
            </ScrollViewer>

            <Border Grid.Column="1" Background="#303640" Padding="14" Margin="0,0,0,5">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Selected Object" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,0,0,12"/>
                        <TextBlock Text="Name" Foreground="White"/>
                        <TextBox x:Name="ObjectNameBox" Margin="0,4,5,12" Padding="6" Text="{Binding SelectedFurnitureName, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="Position X (mm)" Foreground="White"/>
                        <TextBox x:Name="ObjectXBox" Margin="0,4,5,12" Padding="6" Text="{Binding SelectedFurnitureXmm, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="Position Y (mm)" Foreground="White"/>
                        <TextBox x:Name="ObjectYBox" Margin="0,4,5,12" Padding="6" Text="{Binding SelectedFurnitureYmm, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="Length (mm)" Foreground="White"/>
                        <TextBox x:Name="ObjectLengthBox" Margin="0,4,5,12" Padding="6" Text="{Binding SelectedFurnitureLengthMm, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="Width (mm)" Foreground="White"/> 
                        
                        <TextBox x:Name="ObjectWidthBox" Margin="0,4,5,12" Padding="6" Text="{Binding SelectedFurnitureWidthMm, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Content="Apply Object Changes" Command="{Binding ApplyFurnitureChangesCommand}" Margin="3" Padding="14,7"/>
                        <Separator Margin="0,4,0,12"/>

                        <WrapPanel Margin="0,8,0,0">
                            <TextBlock Text="Cab (mm)" Foreground="White" VerticalAlignment="Center" Margin="4"  Width="100"/>
                            <TextBox x:Name="CabLengthBox" Text="2550" Width="65" Margin="4" Padding="5"/>
                            <TextBlock Text="Wheelbase (mm)" Foreground="White" VerticalAlignment="Center" Margin="4" Width="100"/>
                            <TextBox x:Name="WheelbaseBox" Text="1900" Width="65" Margin="4" Padding="5"/>
                            <TextBlock Text="Front arch from front (mm)" Foreground="White" VerticalAlignment="Center" Margin="4"/>
                            <TextBox x:Name="FrontArchOffsetBox" Text="750" Width="65" Margin="4" Padding="5"/>
                            <TextBlock Text="Rear arch from front (mm)" Foreground="White" VerticalAlignment="Center" Margin="4"/>
                            <TextBox x:Name="RearArchOffsetBox" Text="4500" Width="65" Margin="4" Padding="5"/>
                        </WrapPanel>

                        <WrapPanel Margin="0,4,0,0">
                            <TextBlock Text="Arch length (mm)" Foreground="White" VerticalAlignment="Center" Margin="4" Width="100"/>
                            <TextBox x:Name="WheelArchLengthBox" Text="500" Width="65" Margin="4" Padding="5"/>
                            <TextBlock Text="Arch width (mm)" Foreground="White" VerticalAlignment="Center" Margin="4" Width="100"/>
                            <TextBox x:Name="WheelArchWidthBox" Text="150" Width="65" Margin="4" Padding="5"/>
                            <TextBlock Text="Door start (mm)" Foreground="White" VerticalAlignment="Center" Margin="4" Width="100"/>
                            <TextBox x:Name="SlidingDoorStartBox" Text="850" Width="65" Margin="4" Padding="5"/>
                            <TextBlock Text="Door length (mm)" Foreground="White" VerticalAlignment="Center" Margin="4" Width="100"/>
                            <TextBox x:Name="SlidingDoorLengthBox" Text="800" Width="65" Margin="4" Padding="5"/>
                            <Button Content="Apply Geometry" Click="ApplyGeometry_Click" Margin="4" Padding="12,6"/> 
                        </WrapPanel>

                        <Separator Margin="0,4,0,12"/>

                        <TextBlock Text="Measurements are in millimetres. X runs along the van; Y runs across it." Foreground="#D0D4DA" TextWrapping="Wrap" Margin="0,0,0,12"/>
                        <TextBlock Text="Grid snap: 50 mm" Foreground="#D0D4DA"/>
                    </StackPanel>
                
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</Window>
